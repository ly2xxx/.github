$params = @{
    start_date       = "2026-09-15 22:13:37"
    end_date         = "2026-09-15 22:15:30"
    page             = 1
    page_size        = 100
    sort_by          = "startTime"
    sort_order       = "desc"
    group_by_session = "false"
}

$query = ($params.GetEnumerator() | ForEach-Object { "$($_.Key)=$([uri]::EscapeDataString([string]$_.Value))" }) -join "&"

$response = Invoke-RestMethod -Uri "http://localhost:8081/spend/logs/ui?$query" -Headers @{ Authorization = "Bearer sk-admin" }

$response | ConvertTo-Json -Depth 10 | Out-File logs.json

